# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, never expose to the client.
# Used by the cron job to bypass RLS when inserting notifications.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL used to build the QR code target (https://<domain>/product/<id>)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret checked against the Authorization header on the cron endpoint.
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` automatically when set.
CRON_SECRET=change-me

# --- Yayın paneli (/yonetim/yayin) ----------------------------------------
# Panel `staging` dalında bekleyen değişiklikleri gösterir ve onayladığında
# `main` dalını oraya taşır — yani canlıya çıkarır. İkisi de tanımlı değilse
# ekran ne yapılması gerektiğini anlatan bir kurulum notu gösterir, uygulamanın
# geri kalanı etkilenmez.
GITHUB_REPO=firatyildiz0/qr_sistemi
# github.com > Settings > Developer settings > Personal access tokens >
# Fine-grained tokens. Yalnızca bu depoya, yalnızca "Contents: Read and write".
# Bu anahtar depoya yazabilir — sunucuda kalır, tarayıcıya asla gönderilmez.
GITHUB_TOKEN=

# --- Instagram rezervasyon (mesajdan rezervasyon talebi) ------------------
# Üçü birden tanımlı değilse panelde "yapılandırılmamış" yazar ve webhook her
# isteği reddeder; uygulamanın geri kalanı etkilenmez.
#
# developers.facebook.com > uygulamanız > Instagram > API setup with Instagram
# login. Uygulama türü "Business", izinler: instagram_business_basic ve
# instagram_business_manage_messages.
INSTAGRAM_APP_ID=
# Uygulama gizli anahtarı. Gelen webhook imzası bununla doğrulanıyor —
# sunucuda kalır, tarayıcıya asla gitmez.
INSTAGRAM_APP_SECRET=
# Webhook'u kurarken Meta'nın bir kez soracağı belirteç. Kendiniz belirlersiniz;
# Meta panelindeki "Verify token" alanına aynısını yazın.
INSTAGRAM_VERIFY_TOKEN=change-me
#
# Meta panelinde OAuth dönüş adresi olarak <NEXT_PUBLIC_SITE_URL>/api/instagram/callback,
# webhook adresi olarak <NEXT_PUBLIC_SITE_URL>/api/instagram/webhook tanımlanmalı
# ve "messages" alanına abone olunmalı.
