# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, never expose to the client.
# Used by the cron job to bypass RLS when inserting notifications.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL used to build the QR code target (https://<domain>/product/<id>)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret checked against the Authorization header on the cron endpoint.
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` automatically when set.
CRON_SECRET=change-me

# --- Güvenlik uyarıları ---------------------------------------------------
# Kritik bir olayda (yoğun başarısız giriş, cron ucuna geçersiz istek) uyarı
# e-postası gönderilir. Üçü birden tanımlı değilse uyarı yalnızca sunucu
# log'una düşer — uygulama yine çalışır.
# Anahtar: resend.com > API Keys. Gönderen adresin alanı Resend'de doğrulanmalı.
RESEND_API_KEY=
ALERT_EMAIL_TO=sizin@eposta.com
ALERT_EMAIL_FROM=guvenlik@alanadiniz.com

# --- Yayın paneli (/yonetim/yayin) ----------------------------------------
# Panel `staging` dalında bekleyen değişiklikleri gösterir ve onayladığında
# `main` dalını oraya taşır — yani canlıya çıkarır. İkisi de tanımlı değilse
# ekran ne yapılması gerektiğini anlatan bir kurulum notu gösterir, uygulamanın
# geri kalanı etkilenmez.
GITHUB_REPO=firatyildiz0/qr_sistemi
# github.com > Settings > Developer settings > Personal access tokens >
# Fine-grained tokens. Yalnızca bu depoya, yalnızca "Contents: Read and write".
# Bu anahtar depoya yazabilir — sunucuda kalır, tarayıcıya asla gönderilmez.
GITHUB_TOKEN=

# --- Abonelik / ödeme (iyzico) --------------------------------------------
# Dördü birden tanımlı değilse abonelik ekranı kurulum notu gösterir ve tahsilat
# yapılmaz; uygulamanın geri kalanı çalışmaya devam eder.
#
# Anahtarlar: iyzico paneli > Ayarlar > API anahtarları. Sandbox ve canlı için
# ayrı anahtar çiftleri var, karıştırmayın.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Webhook imzasının içine giriyor (bkz. lib/iyzico.ts). Panelde "Üye işyeri no".
IYZICO_MERCHANT_ID=
# `sandbox` (varsayılan) ya da `production`. Bilinçli olarak sandbox varsayılan:
# unutulan bir değişken yüzünden gerçek kart çekilmesin.
IYZICO_ENV=sandbox
# Aylık planın referans kodu. iyzico üretiyor, elle yazılamaz:
#   npm run iyzico:plan
# çıktısındaki kodu buraya yapıştırın. Fiyat değişirse plan da yenilenmeli.
IYZICO_PRICING_PLAN_REF=
# Aylık ücret (TL, KDV dahil). Yalnızca kayıt tutmak için; kullanıcıya gösterilen
# fiyat src/lib/subscription.ts'te, asıl tahsilat tutarı iyzico'daki planda.
IYZICO_PRICE_TRY=999
#
# Webhook: iyzico paneli > Ayarlar > Webhook adresine şunu tanımlayın:
#   https://<alanadiniz>/api/iyzico/webhook
# Bu uç olmadan ilk ay tahsil edilir ama sonraki aylar sisteme işlenmez.

# --- Hata izleme (Sentry) -------------------------------------------------
# DSN boşsa Sentry hiç başlatılmaz. sentry.io > Projects > Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Aşağıdaki üçü yalnızca kaynak haritası yüklemek için; olmadan da hata izleme
# çalışır, sadece yığın izleri derlenmiş kod üzerinden okunur.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
